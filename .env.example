# =================================================================
# Capitol CoDesign - Environment Configuration Example
# =================================================================

# -----------------------------------------------------------------
# 1. LLM Provider Configuration (AI Project Brief Generation)
# -----------------------------------------------------------------
# Default provider: OpenAI (gpt-4o-mini is ultra-low cost: ~$0.0006 per brief)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
OPENAI_API_KEY=

# -----------------------------------------------------------------
# 2. Email Delivery (Resend API)
# -----------------------------------------------------------------
# Shared with existing /api/send-email quote/newsletter handlers
RESEND_API_KEY=
FROM_EMAIL="Capitol CoDesign <agency@capitolcodesign.com>"
NOTIFICATION_EMAIL="agency@capitolcodesign.com"

# -----------------------------------------------------------------
# 3. Anti-Bot Defense (Cloudflare Turnstile)
# -----------------------------------------------------------------
# Matches client widget sitekey on capitolcodesign.com
TURNSTILE_SECRET=
CF_TURNSTILE_SECRET_KEY=

# -----------------------------------------------------------------
# 4. Abuse Prevention & Cost Controls
# -----------------------------------------------------------------
# Master kill switch to toggle brief generation without redeploying
BRIEF_ENABLED=true

# Maximum accepted generations per IP per hour (PRD recommendation: 6)
RATE_LIMIT_MAX_PER_HOUR=6

# Daily spend ceiling / max briefs per day across all visitors
BRIEF_DAILY_BUDGET=100

# Secret salt for privacy-preserving IP hashing (do not store raw IPs)
IP_HASH_SECRET=capitol-codesign-brief-salt-change-in-prod
